<section class="dda-tamer-advancement-app">
  <header class="dda-tamer-advancement-header">
    <div class="dda-tamer-advancement-identity">
      <img src="{{actorImg}}" alt="{{actorName}}" />

      <div>
        <span>{{labels.title}}</span>
        <h2>{{actorName}}</h2>
        <p>{{labels.subtitle}}</p>
      </div>
    </div>

    <div class="dda-tamer-advancement-points">
      <span>{{labels.growthPoints}}</span>
      <strong>{{growthPointsAvailable}}</strong>
    </div>
  </header>

  <div class="dda-tamer-advancement-body">
    <section class="dda-tamer-advancement-guide">
      <div class="dda-tamer-advancement-guide-step"><strong>1</strong><span>{{labels.guideMode}}</span></div>
      <div class="dda-tamer-advancement-guide-step"><strong>2</strong><span>{{labels.guideSpend}}</span></div>
      <div class="dda-tamer-advancement-guide-step"><strong>3</strong><span>{{labels.guideApply}}</span></div>
    </section>
    {{#if hasExperiencedReward}}
      <section class="dda-tamer-advancement-experienced">
        <header>
          <div>
            <span>Experienced</span>
            <h3>{{labels.experiencedTitle}}</h3>
          </div>

          <i
            class="fa-solid fa-star"
            aria-hidden="true"
          ></i>
        </header>

        <p>{{labels.experiencedHint}}</p>

        {{#if canSpend}}
          {{#if experiencedReward.hasEligibleSkills}}
            <label class="dda-tamer-advancement-experienced-skill">
              <span>{{labels.experiencedSkill}}</span>

              <select data-experienced-skill>
                {{#each experiencedReward.skills as |skill|}}
                  <option value="{{skill.key}}">
                    {{skill.label}} — {{skill.value}} / {{skill.cap}}
                  </option>
                {{/each}}
              </select>
            </label>
          {{else}}
            <p class="notification warning">
              {{labels.experiencedNoSkills}}
            </p>
          {{/if}}

          <div class="dda-tamer-advancement-experienced-actions">
            <button
              type="button"
              data-action="claimExperienced"
              {{#unless experiencedReward.hasEligibleSkills}}
                disabled
              {{/unless}}
            >
              <i
                class="fa-solid fa-plus"
                aria-hidden="true"
              ></i>

              {{labels.experiencedClaim}}
            </button>

            <button
              type="button"
              data-action="markExperiencedClaimed"
              class="is-secondary"
            >
              <i
                class="fa-solid fa-check"
                aria-hidden="true"
              ></i>

              {{labels.experiencedMarkApplied}}
            </button>
          </div>
        {{else}}
          <p class="notification warning">
            {{labels.readOnly}}
          </p>
        {{/if}}
      </section>
    {{/if}}

    {{#if hasPackage}}
      {{#if canSpend}}
        <section class="dda-tamer-advancement-package">
          <div>
            <span>{{labels.package}}</span>
            <strong>{{package.scopeLabel}} • {{labels.packagePoints}}</strong>
          </div>

          {{#if package.note}}
            <p>{{package.note}}</p>
          {{/if}}
        </section>

        <aside class="dda-tamer-advancement-aspect-reminder">
          <i class="fa-solid fa-masks-theater" aria-hidden="true"></i>
          <span>{{localize "DDA.Progression.Advancement.AspectReminder"}}</span>
        </aside>

        <section class="dda-tamer-advancement-mode-choice">
          <header>
            <h3>{{labels.modeTitle}}</h3>
            <p>{{labels.modeHint}}</p>
          </header>
          <label>
            <input
              type="radio"
              name="growth-mode"
              value="attribute"
              data-growth-mode
              {{#if modeAttribute}}checked{{/if}}
            />
            <span>{{labels.attributeChoice}}</span>
          </label>

          <label>
            <input
              type="radio"
              name="growth-mode"
              value="skills"
              data-growth-mode
              {{#if modeSkills}}checked{{/if}}
            />
            <span>{{labels.skillChoice}}</span>
          </label>
        </section>

        {{#if modeAttribute}}
          <section class="dda-tamer-advancement-section">
            <header>
              <h3>{{labels.attributes}}</h3>
              <p>{{labels.attributeHint}}</p>
            </header>

            <div class="dda-tamer-advancement-attribute-grid">
              {{#each attributes as |attribute|}}
                <button
                  type="button"
                  data-action="selectAttribute"
                  data-attribute-key="{{attribute.key}}"
                  class="{{#if attribute.selected}}is-selected{{/if}}"
                  {{#unless attribute.canIncrease}}disabled{{/unless}}
                >
                  <strong>{{attribute.label}}</strong>
                  <span>
                    {{labels.current}} {{attribute.value}}
                    •
                    {{labels.cap}} {{attribute.cap}}
                  </span>
                </button>
              {{/each}}
            </div>
          </section>
        {{else}}
          <section class="dda-tamer-advancement-section">
            <header>
              <h3>{{labels.skills}}</h3>
              <p>{{labels.skillHint}}</p>
            </header>

            <div class="dda-tamer-advancement-skill-list">
              {{#each skills as |skill|}}
                <label class="dda-tamer-advancement-skill-row">
                  <span>
                    <strong>{{skill.label}}</strong>
                    <small>
                      {{labels.current}} {{skill.value}}
                      •
                      {{labels.cap}} {{skill.cap}}
                    </small>
                  </span>

                  <input
                    type="number"
                    min="0"
                    max="{{skill.maxIncrease}}"
                    value="{{skill.draftValue}}"
                    data-growth-skill="{{skill.key}}"
                    {{#unless skill.canIncrease}}disabled{{/unless}}
                  />
                </label>
              {{/each}}
            </div>

            <p
              class="dda-tamer-advancement-skill-summary"
              data-growth-skill-summary
            >
              {{labels.allocated}}:
              <strong data-growth-skill-total>{{draftSkillTotal}}</strong>
              /
              {{package.remaining}}
              •
              {{labels.remaining}}:
              <strong data-growth-skill-remaining>{{draftSkillRemaining}}</strong>
            </p>
          </section>
        {{/if}}

        <footer class="dda-tamer-advancement-footer">
          <button type="button" data-action="spendGrowth">
            {{labels.spendPackage}}
          </button>
        </footer>
      {{else}}
        <p class="notification warning">{{labels.readOnly}}</p>
      {{/if}}
    {{else}}
      {{#unless hasExperiencedReward}}
        <p class="notification info">
          {{labels.noPackage}}
        </p>
      {{/unless}}
    {{/if}}
  </div>
</section>