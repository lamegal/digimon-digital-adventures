<form class="dda-gm-tools-form">
  <section class="dda-gm-tools-section">
    <header class="dda-gm-tools-header">
      <img
        class="dda-gm-tools-logo"
        src="systems/digimon-digital-adventures/assets/ui/Digimon-Logo.webp"
        alt="DDA"
      />

      <div>
        <h2>{{localize "DDA.GmTools.HeaderTitle"}}</h2>
        <p>{{localize "DDA.GmTools.HeaderHelp"}}</p>
      </div>
    </header>
  </section>

  <section class="dda-gm-tools-section">
    <h3>{{localize "DDA.GmTools.Targets"}}</h3>

    <label class="dda-gm-tools-field">
      <span>{{localize "DDA.GmTools.TargetModeLabel"}}</span>
      <select name="targetMode">
        {{#each targetModes as |mode|}}
          <option value="{{mode.key}}">{{mode.label}}</option>
        {{/each}}
      </select>
    </label>

    <div class="dda-gm-tools-targets">
      {{#if hasTargets}}
        {{#each targets as |target|}}
          <article class="dda-gm-tools-target">
            <strong>{{target.name}}</strong>
            <span>{{target.wounds}} / {{target.maxWounds}} {{localize "DDA.GmTools.Health"}}</span>

            {{#if target.tempWounds}}
              <span>{{localize "DDA.GmTools.Temp"}}: {{target.tempWounds}}</span>
            {{/if}}

            {{#if target.crashReduction}}
              <span title="{{target.crashReductionTooltip}}">
                {{localize "DDA.GmTools.CrashReduction"}}: {{target.crashReduction}}
              </span>
            {{/if}}
          </article>
        {{/each}}
      {{else}}
        <p class="dda-gm-tools-empty">
          {{localize "DDA.GmTools.NoTargets"}}
        </p>
      {{/if}}
    </div>

    <button type="button" data-action="refresh-targets">
      <i class="fas fa-sync-alt"></i>
      {{localize "DDA.GmTools.RefreshTargets"}}
    </button>
  </section>

  <section class="dda-gm-tools-section">
    <h3>{{localize "DDA.GmTools.ApplyDamageTitle"}}</h3>

    <label class="dda-gm-tools-field">
      <span>{{localize "DDA.GmTools.RawDamage"}}</span>
      <input type="number" name="damage" value="1" min="1" step="1" />
    </label>

    <label class="dda-gm-tools-field">
      <span>{{localize "DDA.GmTools.DamageTypeLabel"}}</span>
      <select name="damageType">
        {{#each damageTypes as |damageType|}}
          <option value="{{damageType.key}}">{{damageType.label}}</option>
        {{/each}}
      </select>
    </label>

    <label class="dda-gm-tools-check">
      <input type="checkbox" name="createChat" checked />
      <span>{{localize "DDA.GmTools.CreateChatCard"}}</span>
    </label>

    <button type="button" class="dda-gm-tools-primary" data-action="apply-damage">
      <i class="fas fa-bolt"></i>
      {{localize "DDA.GmTools.ApplyDamage"}}
    </button>
  </section>
</form>