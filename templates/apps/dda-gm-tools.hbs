<div class="dda-gm-tools-body">
  <section class="dda-gm-tools-section">
    <header class="dda-gm-tools-header">
      <img
        class="dda-gm-tools-logo"
        src="systems/digimon-digital-adventures/assets/ui/Digimon-Logo-3.webp"
        alt="DDA"
      />

      <div class="dda-gm-tools-header-copy">
        <span class="dda-gm-tools-kicker">DDA // GM CONSOLE</span>
        <h2>{{localize "DDA.GmTools.HeaderTitle"}}</h2>
        <p>{{localize "DDA.GmTools.HeaderHelp"}}</p>
      </div>
    </header>
  </section>

  <section class="dda-gm-tools-section dda-gm-tools-session-section" data-section="session">
    <div class="dda-gm-tools-section-accent"></div>
    <div class="dda-gm-tools-session-header">
      <div>
        <h3>{{localize "DDA.GmTools.Session.Title"}}</h3>
        <p>{{localize "DDA.GmTools.Session.Help"}}</p>
      </div>

      <span class="dda-gm-tools-session-status {{#if session.active}}active{{else}}inactive{{/if}}">
        {{session.statusLabel}}
      </span>
    </div>

    {{#if session.active}}
      <dl class="dda-gm-tools-session-details">
        <div>
          <dt>{{localize "DDA.GmTools.Session.StartedAt"}}</dt>
          <dd>{{session.startedAtLabel}}</dd>
        </div>

        <div>
          <dt>{{localize "DDA.GmTools.Session.StartedBy"}}</dt>
          <dd>{{session.startedBy.name}}</dd>
        </div>
      </dl>
    {{/if}}

    <div class="dda-gm-tools-session-actions">
      <button type="button" data-action="start-session">
        <i class="fas fa-play"></i>
        {{localize "DDA.GmTools.Session.Start"}}
      </button>

      <button
        type="button"
        data-action="end-session"
        {{#unless session.active}}disabled{{/unless}}
      >
        <i class="fas fa-stop"></i>
        {{localize "DDA.GmTools.Session.End"}}
      </button>
    </div>
  </section>

  <section class="dda-gm-tools-section" data-section="targets">
    <div class="dda-gm-tools-section-accent"></div>
    <div class="dda-gm-tools-title-row">
      <span class="dda-gm-tools-section-icon"><i class="fas fa-crosshairs"></i></span>
      <h3>{{localize "DDA.GmTools.Targets"}}</h3>
      <span class="dda-gm-tools-count-badge">{{#if hasTargets}}{{targets.length}}{{else}}0{{/if}}</span>
    </div>

    <label class="dda-gm-tools-field">
      <span>{{localize "DDA.GmTools.TargetModeLabel"}}</span>
      <select name="targetMode">
        {{#each targetModes as |mode|}}
          <option value="{{mode.key}}">{{mode.label}}</option>
        {{/each}}
      </select>
    </label>

    <div class="dda-gm-tools-targets">
      {{#if hasTargets}}
        {{#each targets as |target|}}
          <article class="dda-gm-tools-target">
            <strong>{{target.name}}</strong>
            <span>{{target.wounds}} / {{target.maxWounds}} {{localize "DDA.GmTools.Health"}}</span>
            <span>{{localize "DDA.GmTools.Actions.Short"}}: {{target.actions}} / {{target.maxActions}}</span>

            {{#if target.tempWounds}}
              <span>{{localize "DDA.GmTools.Temp"}}: {{target.tempWounds}}</span>
            {{/if}}

            {{#if target.crashReduction}}
              <span title="{{target.crashReductionTooltip}}">
                {{localize "DDA.GmTools.CrashReduction"}}: {{target.crashReduction}}
              </span>
            {{/if}}
          </article>
        {{/each}}
      {{else}}
        <p class="dda-gm-tools-empty">
          {{localize "DDA.GmTools.NoTargets"}}
        </p>
      {{/if}}
    </div>

    <button type="button" data-action="refresh-targets">
      <i class="fas fa-sync-alt"></i>
      {{localize "DDA.GmTools.RefreshTargets"}}
    </button>
  </section>

  <section class="dda-gm-tools-section dda-gm-tools-override-section" data-section="overrides">
    <div class="dda-gm-tools-section-accent"></div>
    <div class="dda-gm-tools-title-row">
      <span class="dda-gm-tools-section-icon"><i class="fas fa-sliders"></i></span>
      <h3>{{localize "DDA.GmTools.Override.Title"}}</h3>
    </div>
    <p class="dda-gm-tools-section-help">{{localize "DDA.GmTools.Override.Help"}}</p>

    <label class="dda-gm-tools-field">
      <span>{{localize "DDA.GmTools.Actions.Amount"}}</span>
      <input type="number" name="actionAmount" value="1" min="1" step="1" />
    </label>

    <div class="dda-gm-tools-action-grid">
      <button type="button" data-action="grant-actions">
        <i class="fas fa-plus-circle"></i>
        {{localize "DDA.GmTools.Actions.Grant"}}
      </button>

      <button type="button" data-action="restore-actions">
        <i class="fas fa-rotate-left"></i>
        {{localize "DDA.GmTools.Actions.Restore"}}
      </button>

      <button type="button" data-action="grant-unrestricted-movement">
        <i class="fas fa-person-running"></i>
        {{localize "DDA.GmTools.Movement.GrantUnrestricted"}}
      </button>

      <button type="button" data-action="clear-movement">
        <i class="fas fa-ban"></i>
        {{localize "DDA.GmTools.Movement.Clear"}}
      </button>
    </div>

    <p class="dda-gm-tools-override-note">
      <i class="fas fa-circle-info"></i>
      {{localize "DDA.GmTools.Override.Note"}}
    </p>
  </section>

  <section class="dda-gm-tools-section" data-section="damage">
    <div class="dda-gm-tools-section-accent"></div>
    <div class="dda-gm-tools-title-row">
      <span class="dda-gm-tools-section-icon"><i class="fas fa-bolt"></i></span>
      <h3>{{localize "DDA.GmTools.ApplyDamageTitle"}}</h3>
    </div>

    <label class="dda-gm-tools-field">
      <span>{{localize "DDA.GmTools.RawDamage"}}</span>
      <input type="number" name="damage" value="1" min="1" step="1" />
    </label>

    <label class="dda-gm-tools-field">
      <span>{{localize "DDA.GmTools.DamageTypeLabel"}}</span>
      <select name="damageType">
        {{#each damageTypes as |damageType|}}
          <option value="{{damageType.key}}">{{damageType.label}}</option>
        {{/each}}
      </select>
    </label>

    <label class="dda-gm-tools-check">
      <input type="checkbox" name="createChat" checked />
      <span>{{localize "DDA.GmTools.CreateChatCard"}}</span>
    </label>

    <button type="button" class="dda-gm-tools-primary" data-action="apply-damage">
      <i class="fas fa-bolt"></i>
      {{localize "DDA.GmTools.ApplyDamage"}}
    </button>
  </section>
</div>
