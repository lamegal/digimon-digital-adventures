<section class="dda-partner-form-planner__root">
  {{#unless ready}}
    <div class="dda-partner-form-planner__empty">
      <i class="fas fa-exclamation-triangle"></i>
      <p>{{localize "DDA.PartnerFormPlanner.Unavailable"}}</p>
    </div>
  {{else}}
    <header class="dda-partner-form-planner__header">
      <div class="dda-partner-form-planner__identity">
        <img
          src="{{partner.img}}"
          alt="{{partner.name}}"
          data-fallback-index="0"
          data-fallback-srcs="{{partner.imageFallbacks}}"
        >
        <div>
          <span>{{tamer.name}}</span>
          <h2>{{partner.name}}</h2>
          <p>{{localize "DDA.PartnerFormPlanner.Subtitle"}}</p>
        </div>
      </div>

      <div class="dda-partner-form-planner__header-actions">
        {{#if isGM}}
          <button
            type="button"
            class="dda-partner-form-planner__release-button"
            data-action="releaseUnlockedForms"
            {{#unless hasReleaseableForms}}disabled{{/unless}}
          >
            <i class="fas fa-unlock-alt"></i>
            <span>{{localize "DDA.PartnerFormPlanner.Release.Button"}}</span>
            <strong>{{releaseableCount}}</strong>
          </button>
        {{/if}}

        <button type="button" data-action="refresh">
          <i class="fas fa-sync-alt"></i>
          {{localize "DDA.PartnerFormPlanner.Refresh"}}
        </button>
      </div>
    </header>

    <div class="dda-partner-form-planner__body">
      <section class="dda-partner-form-planner__intro">
        <i class="fas fa-info-circle"></i>
        <p>{{localize "DDA.PartnerFormPlanner.Help"}}</p>
      </section>

      {{#if darkEvolutionMode}}
        <section class="dda-partner-form-planner__dark-mode-banner">
          <i class="fas fa-moon"></i>
          <div>
            <strong>{{localize "DDA.PartnerFormPlanner.Dark.ModeLabel"}}</strong>
            <p>{{localize "DDA.PartnerFormPlanner.Dark.ModeHint"}}</p>
          </div>
        </section>
      {{/if}}

      {{#if hasJogressPlans}}
        <section class="dda-partner-form-planner__jogress">
          <header>
            <div>
              <h3><i class="fas fa-link"></i> {{localize "DDA.PartnerFormPlanner.Jogress.Title"}}</h3>
              <p>{{localize "DDA.PartnerFormPlanner.Jogress.Hint"}}</p>
            </div>
          </header>

          <div class="dda-partner-form-planner__jogress-grid">
            {{#each jogressPlans as |plan|}}
              <article class="dda-partner-form-planner__jogress-card {{#if plan.prepared}}is-prepared{{/if}}">
                <img src="{{plan.resultImg}}" alt="{{plan.resultName}}">
                <div class="dda-partner-form-planner__jogress-copy">
                  <span>{{plan.resultStageLabel}}</span>
                  <strong>{{plan.resultName}}</strong>
                  <small>{{plan.sourceFormName}} + {{plan.partnerFormName}} ({{plan.partnerTamerName}})</small>
                  <div class="dda-partner-form-planner__jogress-budget">
                    <span>{{localize "DDA.PartnerFormPlanner.Jogress.BaseDP"}} <b>{{plan.baseDp}}</b></span>
                    <span>+ {{plan.primaryBonusDp}}</span>
                    <span>+ {{plan.secondaryBonusDp}}</span>
                    <strong>= {{plan.totalDp}} {{localize "DDA.Resource.DP.Short"}}</strong>
                  </div>
                </div>
                <button
                  type="button"
                  data-action="planJogress"
                  data-jogress-plan-key="{{plan.key}}"
                >
                  <i class="fas {{#if plan.prepared}}fa-sliders-h{{else}}fa-hammer{{/if}}"></i>
                  {{#if plan.prepared}}
                    {{localize "DDA.PartnerFormPlanner.Jogress.Adjust"}}
                  {{else}}
                    {{localize "DDA.PartnerFormPlanner.Jogress.Prepare"}}
                  {{/if}}
                </button>
              </article>
            {{/each}}
          </div>
        </section>
      {{/if}}

      {{#if hasForms}}
        <section class="dda-partner-form-planner__forms">
          <header>
            <div>
              <h3>{{localize "DDA.PartnerFormPlanner.PreparedForms"}}</h3>
              <p>{{localize "DDA.PartnerFormPlanner.PreparedFormsHint"}}</p>
            </div>
          </header>

          <div class="dda-form-build-summary-grid">
            {{#each forms as |form|}}
              <article class="dda-form-build-summary-card stage-{{form.stageKey}} {{form.dp.statusClass}} {{#if form.isCurrent}}main-form{{/if}}">
                <header>
                  <img
                    src="{{form.img}}"
                    alt="{{form.species}}"
                    data-fallback-index="0"
                    data-fallback-srcs="{{form.imageFallbacks}}"
                  >
                  <div>
                    <span>{{form.stageLabel}}</span>
                    <strong>{{form.species}}</strong>

                    <div class="dda-partner-form-planner__badges">
                      {{#if form.isCurrent}}
                        <em>{{localize "DDA.PartnerFormPlanner.CurrentForm"}}</em>
                      {{else if form.released}}
                        <em class="is-released">
                          <i class="fas fa-check-circle"></i>
                          {{localize "DDA.PartnerFormPlanner.Release.Released"}}
                        </em>
                      {{else if form.canRelease}}
                        <em class="is-ready-release">
                          <i class="fas fa-unlock-alt"></i>
                          {{localize "DDA.PartnerFormPlanner.Release.Ready"}}
                        </em>
                      {{else if form.prepared}}
                        <em>{{localize "DDA.PartnerFormPlanner.PreparedForm"}}</em>
                      {{else if form.createdByInitialLine}}
                        <em>{{localize "DDA.PartnerFormPlanner.InitialLineForm"}}</em>
                      {{/if}}

                      {{#each form.categories as |category|}}
                        <em class="is-category category-{{category.key}}">
                          {{category.label}}
                        </em>
                      {{/each}}

                      {{#unless (eq form.plannedEvolutionMethod "normal")}}
                        <em class="is-method method-{{form.plannedEvolutionMethod}}">
                          <i class="fas fa-random"></i>
                          {{form.plannedEvolutionMethodLabel}}
                        </em>
                      {{/unless}}

                      {{#if form.unlocked}}
                        <em class="is-unlocked">
                          <i class="fas fa-lock-open"></i>
                          {{localize "DDA.PartnerFormPlanner.StageUnlocked"}}
                        </em>
                      {{else}}
                        <em class="is-locked">
                          <i class="fas fa-lock"></i>
                          {{localize "DDA.PartnerFormPlanner.StageLocked"}}
                        </em>
                      {{/if}}
                    </div>
                  </div>
                </header>

                <div class="dda-form-build-summary-budget {{form.dp.statusClass}}">
                  <span>{{localize "DDA.Resource.DP.Short"}}</span>
                  <strong>{{form.dp.spent}} / {{form.dp.total}}</strong>
                  <small>
                    {{form.dp.remaining}}
                    {{localize "DDA.Creation.RemainingDP"}}
                  </small>
                </div>

                {{#if form.canEdit}}
                  <div class="dda-form-build-card-actions">
                    <button
                      type="button"
                      class="dda-form-build-adjust-button {{form.adjustment.className}}"
                      data-action="adjustForm"
                      data-form-uuid="{{form.sourceFormUuid}}"
                    >
                      <span class="dda-form-build-adjust-button__icon">
                        <i class="fas fa-sliders-h"></i>
                      </span>

                      <span class="dda-form-build-adjust-button__copy">
                        <strong>{{form.adjustment.label}}</strong>
                        <small>{{localize "DDA.PartnerFormPlanner.AdjustCaption"}}</small>
                      </span>

                      <i class="fas fa-chevron-right"></i>
                    </button>

                    {{#if form.canRemove}}
                      <button
                        type="button"
                        class="dda-form-build-remove-button"
                        data-action="removeForm"
                        data-form-uuid="{{form.sourceFormUuid}}"
                        title="{{localize 'DDA.PartnerFormPlanner.Remove.ButtonHint'}}"
                      >
                        <i class="fas fa-trash-alt"></i>
                        <span>{{localize "DDA.PartnerFormPlanner.Remove.Button"}}</span>
                      </button>
                    {{/if}}
                  </div>
                {{/if}}

                <dl>
                  <dt>{{localize "DDA.MainStat.Accuracy"}}</dt>
                  <dd>{{form.stats.accuracy}}</dd>

                  <dt>{{localize "DDA.MainStat.Damage"}}</dt>
                  <dd>{{form.stats.damage}}</dd>

                  <dt>{{localize "DDA.MainStat.Dodge"}}</dt>
                  <dd>{{form.stats.dodge}}</dd>

                  <dt>{{localize "DDA.MainStat.Armor"}}</dt>
                  <dd>{{form.stats.armor}}</dd>

                  <dt>{{localize "DDA.MainStat.Health"}}</dt>
                  <dd>{{form.stats.health}}</dd>
                </dl>

                <div class="dda-form-build-summary-section">
                  <h4>{{localize "DDA.DigimonWizard.Summary.Attacks"}}</h4>

                  {{#if form.attacks.length}}
                    <ul>
                      {{#each form.attacks as |attack|}}
                        <li>{{attack.name}}</li>
                      {{/each}}
                    </ul>
                  {{else}}
                    <p>{{localize "DDA.Label.None"}}.</p>
                  {{/if}}
                </div>

                <div class="dda-form-build-summary-section">
                  <h4>{{localize "DDA.DigimonWizard.Qualities.Positive"}}</h4>

                  {{#if form.qualitiesPositive.length}}
                    <ul>
                      {{#each form.qualitiesPositive as |quality|}}
                        <li
                          data-tooltip="{{quality.description}}"
                          data-tooltip-direction="UP"
                        >
                          {{quality.name}}
                        </li>
                      {{/each}}
                    </ul>
                  {{else}}
                    <p>{{localize "DDA.Label.None"}}.</p>
                  {{/if}}

                  <h4>{{localize "DDA.DigimonWizard.Qualities.Negative"}}</h4>

                  {{#if form.qualitiesNegative.length}}
                    <ul>
                      {{#each form.qualitiesNegative as |quality|}}
                        <li
                          data-tooltip="{{quality.description}}"
                          data-tooltip-direction="UP"
                        >
                          {{quality.name}}
                        </li>
                      {{/each}}
                    </ul>
                  {{else}}
                    <p>{{localize "DDA.Label.None"}}.</p>
                  {{/if}}
                </div>
              </article>
            {{/each}}
          </div>
        </section>
      {{else}}
        <div class="dda-partner-form-planner__empty">
          <i class="fas fa-project-diagram"></i>
          <p>{{localize "DDA.PartnerFormPlanner.NoPreparedForms"}}</p>
        </div>
      {{/if}}

      <section class="dda-partner-form-planner__add">
        <header>
          <div>
            <h3>{{localize "DDA.PartnerFormPlanner.AddForm"}}</h3>
            <p>{{localize "DDA.PartnerFormPlanner.AddFormHint"}}</p>
          </div>
        </header>

        <div class="dda-partner-form-planner__stage-grid">
          {{#each stages as |stage|}}
            <button
              type="button"
              class="{{#if stage.unlocked}}is-unlocked{{else}}is-locked{{/if}}"
              data-action="addForm"
              data-stage-key="{{stage.key}}"
              {{#unless ../canEdit}}disabled{{/unless}}
            >
              <span>
                {{#if stage.unlocked}}
                  <i class="fas fa-lock-open"></i>
                {{else}}
                  <i class="fas fa-lock"></i>
                {{/if}}
                {{stage.label}}
              </span>

              <small>
                {{stage.formCount}}
                {{localize "DDA.PartnerFormPlanner.PreparedCount"}}
              </small>
            </button>
          {{/each}}
        </div>
      </section>
    </div>
  {{/unless}}
</section>
