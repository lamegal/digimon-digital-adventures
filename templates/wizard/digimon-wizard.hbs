<form class="dda-wizard-form dda-digimon-wizard-form" data-step="{{step}}">

  <header class="dda-wizard-header">
    <div class="dda-wizard-title-group">
      <span class="dda-wizard-header-mark" aria-hidden="true"><span></span></span>

      <div class="dda-wizard-header-copy">
        <h1>{{wizardTitle}}</h1>
        <p>
          <strong>{{progressLabel}}</strong>
          <span>{{localize "DDA.Wizard.StepLower"}} {{stepIndex}} {{localize "DDA.Wizard.Of"}} {{totalSteps}}</span>
        </p>
      </div>
    </div>

    <div
      class="dda-wizard-progress"
      role="progressbar"
      aria-label="{{progressLabel}}"
      aria-valuemin="1"
      aria-valuemax="{{totalSteps}}"
      aria-valuenow="{{stepIndex}}"
    >
      {{#each progressSteps as |stepDot|}}
        <span class="dda-wizard-dot {{#if stepDot.active}}active{{/if}} {{#if stepDot.done}}done{{/if}}" aria-hidden="true"></span>
      {{/each}}
    </div>
  </header>

  <main class="dda-wizard-body" data-dda-scroll-container>

    <aside class="dda-wizard-guide">
      <div class="dda-wizard-guide-portrait" aria-label="Wizardmon"><img src="systems/digimon-digital-adventures/assets/ui/wizardmon%20-%20portrait.webp" alt="Wizardmon"></div>

      <div class="dda-wizard-guide-text">
        <strong>{{guide.title}}</strong>
        <p>{{guide.text}}</p>
      </div>
    </aside>


    {{#if (eq step "welcome")}}
      <section class="dda-wizard-step">
        <h2>{{localize "DDA.DigimonWizard.Welcome.Title"}}</h2>

        <p>
          {{localize "DDA.DigimonWizard.Welcome.Text1"}}
          {{localize "DDA.DigimonWizard.Welcome.Text2"}}
        </p>

        <p class="dda-wizard-hint">
          {{localize "DDA.DigimonWizard.Welcome.Hint"}}
        </p>
      </section>
    {{/if}}

    {{#if (eq step "origin")}}
      <section class="dda-wizard-step dda-wizard-origin-step">
        <h2>{{localize "DDA.DigimonWizard.Origin.Title"}}</h2>

        <p>{{localize "DDA.DigimonWizard.Origin.Help"}}</p>

        <div class="dda-wizard-mode-grid">
          <button
            type="button"
            class="dda-wizard-mode-card {{#if (eq data.creationMode 'custom')}}selected{{/if}}"
            data-action="select-creation-mode"
            data-mode="custom"
          >
            <strong>{{localize "DDA.DigimonWizard.Origin.CustomTitle"}}</strong>
            <span>{{localize "DDA.DigimonWizard.Origin.CustomText"}}</span>
          </button>

          <button
            type="button"
            class="dda-wizard-mode-card {{#if (eq data.creationMode 'existing')}}selected{{/if}}"
            data-action="select-creation-mode"
            data-mode="existing"
          >
            <strong>{{localize "DDA.DigimonWizard.Origin.ExistingTitle"}}</strong>
            <span>{{localize "DDA.DigimonWizard.Origin.ExistingText"}}</span>
          </button>
        </div>

        <label class="dda-wizard-tutorial-toggle">
          <input type="checkbox" {{#if data.tutorialMode}}checked{{/if}} data-action="toggle-tutorial">
          <span>{{localize "DDA.DigimonWizard.Tutorial.Toggle"}}</span>
        </label>

                <label class="dda-wizard-build-template-toggle {{#if data.buildTemplate.enabled}}active{{/if}}">
          <input type="checkbox" {{#if data.buildTemplate.enabled}}checked{{/if}} data-action="toggle-build-template">

          <span class="dda-build-template-toggle-icon">✨</span>

          <span class="dda-build-template-toggle-copy">
            <strong>{{localize "DDA.DigimonWizard.BuildTemplate.Toggle"}}</strong>
            <small>{{localize "DDA.DigimonWizard.BuildTemplate.ToggleHint"}}</small>
          </span>
        </label>

        <p class="dda-wizard-build-template-note">
          {{localize "DDA.DigimonWizard.BuildTemplate.RookieOnlyHint"}}
        </p>
      </section>
    {{/if}}

    {{#if (eq step "compatibilityIntro")}}
      <section class="dda-wizard-step dda-compatibility-intro-step">
        <h2>{{localize "DDA.DigimonWizard.Questionnaire.Title"}}</h2>

        <div class="dda-compatibility-intro-card">
          <div class="dda-compatibility-device-glow"></div>
          <h3>{{localize "DDA.DigimonWizard.Questionnaire.DetectTitle"}}</h3>
          <p>
            {{localize "DDA.DigimonWizard.Questionnaire.Intro1"}}
            {{localize "DDA.DigimonWizard.Questionnaire.Intro2"}}
          </p>
          <p class="dda-wizard-hint">
            {{localize "DDA.DigimonWizard.Questionnaire.SecretHint"}}
          </p>

          <div class="dda-questionnaire-choice-actions">
            <button type="button" class="primary" data-action="questionnaire-choice" data-value="yes">{{localize "DDA.DigimonWizard.Questionnaire.AnswerButton"}}</button>
            <button type="button" data-action="questionnaire-choice" data-value="no">{{localize "DDA.DigimonWizard.Questionnaire.SkipForNow"}}</button>
          </div>
        </div>
      </section>
    {{/if}}

    {{#if (eq step "compatibility")}}
      <section class="dda-wizard-step dda-compatibility-step">
        <h2>{{localize "DDA.DigimonWizard.Questionnaire.TamerTitle"}}</h2>

        <p>
          {{localize "DDA.DigimonWizard.Questionnaire.TamerIntro1"}}
          {{localize "DDA.DigimonWizard.Questionnaire.TamerIntro2"}}
        </p>

<div class="dda-compatibility-progress-card">
  <strong>{{localize "DDA.DigimonWizard.Questionnaire.RegisteredAnswers"}}</strong>
  <span>{{data.compatibility.answerList.length}} / 16</span>
</div>

<div class="dda-compatibility-question-list">
  {{#each compatibilityQuestions as |question|}}
            <article class="dda-compatibility-question {{#if question.answered}}answered{{/if}}">
              <h3>{{question.number}}. {{question.text}}</h3>

              <div class="dda-compatibility-answer-grid">
                {{#each question.answers as |answer|}}
                  <button
                    type="button"
                    class="dda-compatibility-answer {{#if answer.selected}}selected{{/if}}"
                    data-compatibility-answer
                    data-question-id="{{question.id}}"
                    data-answer-key="{{answer.key}}"
                  >
                    <strong>{{answer.key}}</strong>
                    <span>{{answer.text}}</span>
                  </button>
                {{/each}}
              </div>
            </article>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if (eq step "digitama")}}
      <section class="dda-wizard-step dda-digitama-step">
        <h2>{{compatibilityFinalQuestion.text}}</h2>

        <p>
          {{localize "DDA.DigimonWizard.Questionnaire.FinalHint"}}
        </p>

        <div class="dda-hidden-crest-card dda-hidden-crest-card-secret">
          <div class="dda-hidden-crest-symbol">?</div>
          <div>
            <strong>{{localize "DDA.DigimonWizard.Questionnaire.ResonanceTitle"}}</strong>
            <span>{{localize "DDA.DigimonWizard.Questionnaire.ResonanceText"}}</span>
          </div>
        </div>

        <div class="dda-digitama-choice-grid">
          {{#each compatibilityRecommendations as |digitama|}}
            <button
              type="button"
              class="dda-digitama-choice {{#if digitama.selected}}selected{{/if}} {{#if digitama.used}}used{{/if}}"
              data-action="select-digitama"
              data-digitama-key="{{digitama.key}}"
              title="Digitama"
              aria-label="{{localize 'DDA.DigimonWizard.Questionnaire.ChooseAnswer'}} {{digitama.finalAnswerKey}}"
            >
              <span class="dda-digitama-orb dda-digitama-orb-{{digitama.visualClass}}" style="{{digitama.visualStyle}}">
                <img
                  src="{{digitama.img}}"
                  data-fallback-index="0"
                  data-fallback-srcs="{{digitama.fallbackSrcs}}"
                  alt="Digitama"
                  onerror="const fallbacks = String(this.dataset.fallbackSrcs || '').split('|').filter(Boolean); const index = Number(this.dataset.fallbackIndex || 0); if (index < fallbacks.length) { this.dataset.fallbackIndex = String(index + 1); this.classList.remove('missing'); this.classList.add('fallback'); this.src = fallbacks[index]; } else { this.classList.add('missing'); this.removeAttribute('src'); }"
                >
              </span>
              <strong>{{digitama.finalAnswerKey}}</strong>
              <small>{{digitama.finalAnswerText}}</small>
            </button>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if (eq step "identity")}}
      <section class="dda-wizard-step">
        <h2>{{localize "DDA.DigimonWizard.Identity.Title"}}</h2>

        <p>
          {{localize "DDA.DigimonWizard.Identity.Help1"}}
          {{localize "DDA.DigimonWizard.Identity.Help2"}}
        </p>

{{#unless data.initialLine.baby1LockedByQuestionnaire}}
  {{#if (eq data.creationMode "existing")}}
    <div class="dda-main-form-browser">
            <h3>{{localize "DDA.DigimonWizard.MainForm.DatabaseTitle"}}</h3>

            <div class="dda-main-form-grid">
              {{#each mainFormOptions as |option|}}
                <button
                  type="button"
                  class="dda-main-form-card {{#if option.selected}}selected{{/if}}"
                  data-action="select-main-form"
                  data-stage-key="{{option.stageKey}}"
                  data-digimon-id="{{option.id}}"
                >
                  <img
                  src="{{option.img}}"
                  data-fallback-index="0"
                  data-fallback-srcs="{{option.imageFallbacks}}"
                  alt="{{option.name}}"
                  onerror="const fallbacks = String(this.dataset.fallbackSrcs || '').split('|').filter(Boolean); const index = Number(this.dataset.fallbackIndex || 0); if (index < fallbacks.length) { this.dataset.fallbackIndex = String(index + 1); this.src = fallbacks[index]; } else { this.src = 'icons/svg/mystery-man.svg'; }"
                >
                  <strong>{{option.name}}</strong>

                  {{#if option.originalName}}
                    <small>{{option.originalName}}</small>
                  {{/if}}

                  <span>{{option.stageLabel}}</span>
                </button>
              {{/each}}
            </div>
          </div>
        {{/if}}
        {{/unless}}

        {{#if data.compatibility.digitama}}
          <div class="dda-wizard-revealed-partner-card dda-wizard-auto-identity-card">
            <div class="dda-auto-identity-portrait {{#if identityPixelArt}}has-pixelart{{/if}}">
              <div class="dda-auto-identity-screen">
                {{#if identityPixelArt}}
                  <img class="dda-auto-identity-ghost" src="{{data.identity.img}}" alt="" aria-hidden="true">
                  <img class="dda-auto-identity-pixelart" src="{{identityPixelArt}}" alt="{{data.identity.species}}">
                {{else}}
                  <img class="dda-auto-identity-mainart" src="{{data.identity.img}}" alt="{{data.identity.species}}">
                {{/if}}
              </div>
            </div>

            <div class="dda-auto-identity-content">
              <header class="dda-auto-identity-header">
                <div>
                  <span class="dda-auto-identity-kicker">{{localize "DDA.DigimonWizard.Identity.AutoSpecies"}}</span>
                  <strong>{{data.identity.species}}</strong>
                </div>

                <span class="dda-auto-identity-stage">{{data.stage}}</span>
              </header>

              <dl class="dda-auto-identity-grid">
                <div>
                  <dt>{{localize "DDA.Label.Name"}}</dt>
                  <dd>{{data.identity.name}}</dd>
                </div>

                <div>
                  <dt>{{localize "DDA.Label.Attribute"}}</dt>
                  <dd>{{identityLabels.attribute}}</dd>
                </div>

                <div>
                  <dt>{{localize "DDA.Label.Type"}}</dt>
                  <dd>{{identityLabels.type}}</dd>
                </div>

                <div>
                  <dt>{{localize "DDA.Label.Group"}}</dt>
                  <dd>{{identityLabels.group}}</dd>
                </div>

                <div>
                  <dt>{{localize "DDA.Label.Field"}}</dt>
                  <dd>{{identityLabels.field}}</dd>
                </div>
              </dl>
            </div>

            <input type="hidden" data-path="identity.name" value="{{data.identity.name}}">
            <input type="hidden" data-path="identity.species" value="{{data.identity.species}}">
            <input type="hidden" data-path="identity.attribute" value="{{data.identity.attribute}}">
            <input type="hidden" data-path="identity.type" value="{{data.identity.type}}">
            <input type="hidden" data-path="identity.group" value="{{data.identity.group}}">
            <input type="hidden" data-path="identity.field" value="{{data.identity.field}}">
          </div>
        {{else}}
          <div class="dda-wizard-identity-grid">
            <div class="dda-wizard-field">
              <label>{{localize "DDA.DigimonWizard.Identity.DigimonName"}}</label>
              <input type="text" data-path="identity.name" value="{{data.identity.name}}" placeholder="{{localize 'DDA.DigimonWizard.Identity.NamePlaceholder'}}">
              <small>{{localize "DDA.DigimonWizard.Identity.NameHint"}}</small>
            </div>

            <div class="dda-wizard-field">
              <label>{{localize "DDA.DigimonWizard.Identity.Species"}}</label>
              <input type="text" data-path="identity.species" value="{{data.identity.species}}" placeholder="Ex.: Agumon">
              <small>{{localize "DDA.DigimonWizard.Identity.SpeciesHint"}}</small>
            </div>

            <div class="dda-wizard-field">
              <label>{{localize "DDA.Label.Attribute"}}</label>
              <select data-path="identity.attribute">
                <option value="">{{localize "DDA.DigimonWizard.Identity.ChooseAttribute"}}</option>

                {{#each identityOptions.attributes as |option|}}
                  <option value="{{option.key}}" {{#if (eq ../data.identity.attribute option.key)}}selected{{/if}}>
                    {{option.label}}
                  </option>
                {{/each}}
              </select>
              <small>{{localize "DDA.DigimonWizard.Identity.AttributeHint"}}</small>
            </div>

            <div class="dda-wizard-field">
              <label>{{localize "DDA.Label.Type"}}</label>
              <select data-path="identity.type">
                <option value="">{{localize "DDA.DigimonWizard.Identity.ChooseType"}}</option>

                {{#each identityOptions.types as |option|}}
                  <option value="{{option.key}}" {{#if (eq ../data.identity.type option.key)}}selected{{/if}}>
                    {{option.label}}
                  </option>
                {{/each}}
              </select>
              <small>{{localize "DDA.DigimonWizard.Identity.TypeHint"}}</small>
            </div>

            <div class="dda-wizard-field">
              <label>{{localize "DDA.Label.Group"}}</label>
              <input type="text" data-path="identity.group" value="{{data.identity.group}}" placeholder="{{localize 'DDA.DigimonWizard.Identity.GroupPlaceholder'}}">
              <small>{{localize "DDA.DigimonWizard.Identity.GroupHint"}}</small>
            </div>

            <div class="dda-wizard-field">
              <label>{{localize "DDA.Label.Field"}}</label>
              <select data-path="identity.field">
                <option value="">{{localize "DDA.DigimonWizard.Identity.ChooseField"}}</option>

                {{#each identityOptions.fields as |option|}}
                  <option value="{{option.key}}" {{#if (eq ../data.identity.field option.key)}}selected{{/if}}>
                    {{option.label}}
                  </option>
                {{/each}}
              </select>
              <small>{{localize "DDA.DigimonWizard.Identity.FieldHint"}}</small>
            </div>
          </div>

          <p class="dda-wizard-soft-note">
            {{identityFallbackHint}}
          </p>
        {{/if}}

        <div class="dda-wizard-field">
          <label>{{localize "DDA.DigimonWizard.Identity.ShortDescription"}}</label>
          <textarea data-path="identity.description" rows="4" placeholder="{{localize 'DDA.DigimonWizard.Identity.DescriptionPlaceholder'}}">{{data.identity.description}}</textarea>
        </div>
      </section>
    {{/if}}

{{#if (eq step "evolutionLine")}}
  <section class="dda-wizard-step dda-initial-line-step dda-line-form-step">
    <h2>{{localize "DDA.DigimonWizard.InitialLine.Title"}}</h2>

    <p>
      {{localize "DDA.DigimonWizard.InitialLine.Help"}}
    </p>

    {{#if data.tutorialMode}}
      <aside class="dda-wizard-guide">
        <div class="dda-wizard-guide-portrait" aria-label="Wizardmon">
          <img src="systems/digimon-digital-adventures/assets/ui/wizardmon%20-%20portrait.webp" alt="Wizardmon">
        </div>

        <div class="dda-wizard-guide-text">
          <strong>{{localize "DDA.Wizard.Guide.DefaultTitle"}}</strong>
          <p>{{localize "DDA.DigimonWizard.InitialLine.Tutorial"}}</p>
        </div>
      </aside>
    {{/if}}

    <p class="dda-wizard-hint">
      {{localize "DDA.DigimonWizard.InitialLine.LockedHint"}}
    </p>

    <div class="dda-line-form-chain">
      {{#each initialLineOptions.stageBlocks as |block|}}
        <article class="dda-line-form-card {{#if block.isMain}}main-form{{/if}} {{#unless block.form.species}}empty{{/unless}}">
          <header>
            <span>{{block.title}}</span>

<button
  type="button"
  class="dda-line-main-toggle {{#if block.isMain}}active{{/if}} {{#if block.mainLocked}}locked{{/if}}"
  data-action="set-main-form"
  data-stage-key="{{block.stageKey}}"
  {{#if block.mainLocked}}disabled{{/if}}
>
              {{#if block.isMain}}
                {{localize "DDA.DigimonWizard.InitialLine.MainFormBadge"}}
              {{else}}
                {{localize "DDA.DigimonWizard.InitialLine.MakeMainForm"}}
              {{/if}}
            </button>
          </header>

<div class="dda-line-form-preview">
  <img
    src="{{block.form.img}}"
    data-fallback-index="0"
    data-fallback-srcs="{{block.form.imageFallbacks}}"
    alt="{{block.form.species}}"
    onerror="const fallbacks = String(this.dataset.fallbackSrcs || '').split('|').filter(Boolean); const index = Number(this.dataset.fallbackIndex || 0); if (index < fallbacks.length) { this.dataset.fallbackIndex = String(index + 1); this.src = fallbacks[index]; } else { this.src = 'icons/svg/mystery-man.svg'; }"
  >
</div>

          <div class="dda-line-form-fields">
            <label>
              {{localize "DDA.DigimonWizard.InitialLine.SpeciesField"}}
            <input
              type="text"
              data-path="lineForms.{{block.stageKey}}.species"
              value="{{block.form.species}}"
              placeholder="{{block.title}}"
              {{#if block.lockedByQuestionnaire}}readonly{{/if}}
            >
            {{#if block.lockedByQuestionnaire}}
              <small class="dda-line-questionnaire-lock">
                {{localize "DDA.DigimonWizard.InitialLine.QuestionnaireLockedBaby1"}}
              </small>
            {{/if}}
            </label>

            <div class="dda-line-form-image-actions">
              <button
                type="button"
                data-action="select-line-form-image"
                data-stage-key="{{block.stageKey}}"
                data-image-kind="portrait"
              >
                {{localize "DDA.DigimonWizard.InitialLine.SelectPortrait"}}
              </button>

              <button
                type="button"
                data-action="select-line-form-image"
                data-stage-key="{{block.stageKey}}"
                data-image-kind="token"
              >
                {{localize "DDA.DigimonWizard.InitialLine.SelectToken"}}
              </button>
            </div>

            <small>
              {{localize "DDA.DigimonWizard.InitialLine.TokenHint"}}
            </small>
          </div>

          <section class="dda-line-form-attacks">
            <h4>{{localize "DDA.DigimonWizard.Attacks.Title"}}</h4>

            <div class="dda-line-attack-list">
              {{#each block.form.attackSlots as |attack|}}
                <div class="dda-line-attack-row">
                  <label>
                    {{localize "DDA.DigimonWizard.Attacks.Name"}}
                    <input
                      type="text"
                      data-path="lineForms.{{block.stageKey}}.attacks.{{@index}}.name"
                      value="{{attack.name}}"
                      placeholder="{{localize 'DDA.DigimonWizard.Attacks.Placeholder'}}"
                    >
                  </label>

                  <label>
                    {{localize "DDA.DigimonWizard.Attacks.Range"}}
                    <select data-path="lineForms.{{block.stageKey}}.attacks.{{@index}}.rangeType">
                      <option value="melee" {{#if (eq attack.rangeType "melee")}}selected{{/if}}>
                        {{localize "DDA.Attack.Range.Melee"}}
                      </option>
                      <option value="range" {{#if (eq attack.rangeType "range")}}selected{{/if}}>
                        {{localize "DDA.Attack.Range.Ranged"}}
                      </option>
                    </select>
                  </label>

                  <label>
                    {{localize "DDA.DigimonWizard.Attacks.Function"}}
                    <select data-path="lineForms.{{block.stageKey}}.attacks.{{@index}}.functionType">
                      <option value="damage" {{#if (eq attack.functionType "damage")}}selected{{/if}}>
                        {{localize "DDA.Attack.Function.Damage"}}
                      </option>
                      <option value="support" {{#if (eq attack.functionType "support")}}selected{{/if}}>
                        {{localize "DDA.Attack.Function.Support"}}
                      </option>
                    </select>
                  </label>
                </div>
              {{/each}}
            </div>

            <p class="dda-wizard-hint">
              {{localize "DDA.DigimonWizard.Attacks.Help"}}
            </p>
          </section>

{{#if block.lockedByQuestionnaire}}
  <p class="dda-initial-line-empty dda-line-questionnaire-lock-card">
    {{localize "DDA.DigimonWizard.InitialLine.QuestionnaireLockedBaby1"}}
  </p>
{{else}}
  {{#if (eq ../data.creationMode "existing")}}
    <section class="dda-line-form-suggestions">
  <header class="dda-line-suggestion-header">
    <div>
      <h4>{{block.choiceTitle}}</h4>
      <p>{{block.compatibilityHint}}</p>
    </div>

    <div class="dda-line-suggestion-controls">
      <input
        type="search"
        data-line-search
        data-stage-key="{{block.stageKey}}"
        value="{{block.searchTerm}}"
        placeholder="{{block.searchPlaceholder}}"
      >

      <div class="dda-line-suggestion-modes">
        <button
          type="button"
          class="{{#if block.suggestedActive}}active{{/if}}"
          data-line-mode="suggested"
          data-stage-key="{{block.stageKey}}"
        >
          {{block.suggestedLabel}}
        </button>

        <button
          type="button"
          class="{{#if block.allActive}}active{{/if}}"
          data-line-mode="all"
          data-stage-key="{{block.stageKey}}"
        >
          {{block.allLabel}}
        </button>
      </div>
    </div>
  </header>

  {{#if block.hasOptions}}
    <div class="dda-initial-line-grid dda-compat-line-grid">
      {{#each block.options as |option|}}
        <button
          type="button"
          class="dda-initial-line-card dda-compat-line-card compat-{{option.compatibility.tier}} {{#if option.selected}}selected{{/if}} {{#if option.primary}}primary-line{{/if}}"
          data-action="select-line-form"
          data-stage-key="{{block.stageKey}}"
          data-digimon-id="{{option.id}}"
          title="{{option.compatibility.tooltip}}"
        >
          <span class="dda-compat-badge" aria-label="{{option.compatibility.tooltip}}">
            <i></i>
            <strong>{{option.compatibility.score}}%</strong>
          </span>

          {{#if option.img}}
            <img
              src="{{option.img}}"
              data-fallback-index="0"
              data-fallback-srcs="{{option.imageFallbacks}}"
              alt="{{option.name}}"
              onerror="const fallbacks = String(this.dataset.fallbackSrcs || '').split('|').filter(Boolean); const index = Number(this.dataset.fallbackIndex || 0); if (index < fallbacks.length) { this.dataset.fallbackIndex = String(index + 1); this.src = fallbacks[index]; } else { this.src = 'icons/svg/mystery-man.svg'; }"
            >
          {{/if}}

          <strong class="dda-line-card-name">{{option.name}}</strong>

          {{#if option.originalName}}
            <small>{{option.originalName}}</small>
          {{/if}}

          <span>{{option.stageLabel}}</span>

          <em class="dda-compat-reason">{{option.compatibility.reason}}</em>

          {{#if option.primary}}
            <em class="dda-line-rank-pill">{{localize "DDA.DigimonWizard.InitialLine.Primary"}}</em>
          {{else}}
            {{#if option.compatibility.direct}}
              <em class="dda-line-rank-pill">{{localize "DDA.DigimonWizard.InitialLine.Alternate"}}</em>
            {{/if}}
          {{/if}}
        </button>
      {{/each}}
    </div>
  {{else}}
    <p class="dda-initial-line-empty">
      {{initialLineOptions.noSuggestionsMessage}}
    </p>
  {{/if}}
